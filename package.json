{
  "name": "egopay-bank",
  "version": "1.0.0",
  "description": "EgoPay — digital banking backend integrating with the NibssByPhoenix simulated NIBSS API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm run build && npm run build:frontend",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:start": "tsx scripts/db.ts",
    "onboard": "tsx scripts/onboard.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "smoke:live": "tsx scripts/live-smoke.ts",
    "incoming:demo": "tsx scripts/incoming-demo.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "embedded-postgres": "16.14.0-beta.17",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.0"
  }
}
