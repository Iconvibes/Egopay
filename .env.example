# ===========================================================================
# EgoPay Digital Bank — environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit real secrets.
# ===========================================================================

# Application
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (any PostgreSQL 14+ instance).
# The bundled helper (`npm run db:start`) provides one on port 5433:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/egopay_bank

# Customer-facing JWT (use a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# NibssByPhoenix fintech credentials.
# Obtain them by running:  npm run onboard -- --name "Your Bank" --email you@example.com
# (or call POST https://nibssbyphoenix.onrender.com/api/fintech/onboard directly).
# ---------------------------------------------------------------------------
NIBSS_BASE_URL=https://nibssbyphoenix.onrender.com
NIBSS_API_KEY=
NIBSS_API_SECRET=
NIBSS_TIMEOUT_MS=20000
# Refresh the Nibss JWT (valid 1 hour) this many seconds before expiry
NIBSS_TOKEN_REFRESH_LEEWAY_S=60

# CORS: "*" or a comma-separated allowlist, e.g. "https://app.example.com,http://localhost:5173"
CORS_ORIGIN=*

# Optional admin key that unlocks the dev identity-seeding endpoints
# (POST /api/dev/seed-bvn, POST /api/dev/seed-nin). Leave empty to disable them.
DEV_ADMIN_KEY=

# Explicit opt-in for the authenticated hosted demo KYC helper.
# Keep false for real deployments; set true only for a sandbox/demo deployment.
DEMO_KYC_ENABLED=false

# Secret guarding GET /api/cron/reconcile (serverless balance reconciliation).
# On Vercel, set this env var and Vercel Cron sends it automatically as a
# Bearer token. Generate one:  openssl rand -hex 32
CRON_SECRET=

# Logging / limits
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
# Incoming-payment detection: how often the background poller reconciles each
# account ledger balance. Money arriving is only visible via the balance
# endpoint, so it is polled and diffed against the local cache.
BALANCE_POLL_INTERVAL_S=10
